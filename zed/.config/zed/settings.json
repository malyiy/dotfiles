// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the open default settings command
// from the command palette or from Zed application menu.
{
	// Theme & Appearance
	"base_keymap": "JetBrains",
 "cli_default_open_behavior": "existing_window",
	"debugger": {
		"dock": "left",
	},
	"helix_mode": true,
	"edit_predictions": {
		"provider": "zed",
	},
	"agent_servers": {
		"pi-acp": {
			"type": "registry",
		},
		"glm-acp-agent": {
			"type": "registry",
		},
	},
	"which_key": {
		"delay_ms": 0,
		"enabled": true,
	},
	"git_panel": {
		"dock": "right",
  "tree_view": false,
	},
	"hard_tabs": true,
	"colorize_brackets": true,
	"theme": "Warp One Dark",
	"icon_theme": "Colored Zed Icons Theme Dark",
	"cursor_blink": false,
	"relative_line_numbers": "enabled",
	"show_whitespaces": "all",
	// Fonts
	"ui_font_family": "JetBrainsMonoNL Nerd Font",
	"ui_font_size": 15,
	"ui_font_weight": 600,
	"buffer_font_family": "JetBrainsMonoNL Nerd Font",
	"buffer_font_size": 12,
	"buffer_font_weight": 620,
	// Editor Behavior
	"vim_mode": false,
	"autosave": "on_focus_change",
	"confirm_quit": true,
	"format_on_save": "on",
	"formatter": "prettier",

	// AI & Language Models
	"language_models": {
		"openai_compatible": {
			"dgx": {
				"api_url": "http://labforty-dgx:8000/v1",
				"available_models": [
					{
						"name": "Qwen/Qwen3.6-27B-FP8",
						"max_tokens": 262144,
						"max_output_tokens": 32000,
						"max_completion_tokens": 200000,
						"capabilities": {
							"tools": true,
							"images": false,
							"parallel_tool_calls": false,
							"prompt_cache_key": false,
							"chat_completions": true,
							"interleaved_reasoning": false,
						},
					},
				],
			},
			"Z.AI": {
				"api_url": "https://api.z.ai/api/coding/paas/v4",
				"available_models": [
					{
						"name": "glm-4.7",
						"max_tokens": 204800,
						"max_output_tokens": 32000,
						"max_completion_tokens": 204800,
						"capabilities": {
							"tools": true,
							"images": true,
							"parallel_tool_calls": true,
							"prompt_cache_key": true,
						},
					},
				],
			},
		},
		"ollama": {},
	},
	"agent": {
		"dock": "left",
  "inline_alternatives": [],
		"play_sound_when_agent_done": "always",
		"use_modifier_to_send": true,
		"default_profile": "write",
		"default_model": {
			"enable_thinking": false,
			"provider": "dgx",
			"model": "Qwen/Qwen3.6-27B-FP8",
		},
	},
	// Language Settings
	"lsp_highlight_debounce": 5,
	"inlay_hints": {
		"enabled": true,
		"show_type_hints": false,
		"show_parameter_hints": false,
		"show_other_hints": true,
	},
	"languages": {
		"HTML": {
			"format_on_save": "off",
		},
		"JavaScript": {
			"formatter": [],
			"code_actions_on_format": {
				"source.fixAll.eslint": true,
			},
		},
		"TypeScript": {
			"formatter": [],
			"code_actions_on_format": {
				"source.fixAll.eslint": true,
			},
		},
		"TSX": {
			"formatter": [],
			"code_actions_on_format": {
				"source.fixAll.eslint": true,
			},
		},
	},
	// Panels & UI
	"tabs": {
		"file_icons": true,
		"git_status": true,
	},
	"project_panel": {
		"dock": "right",
	},
	"outline_panel": {
		"dock": "right",
	},
	"collaboration_panel": {
		"dock": "right",
  "button": false,
	},
	"terminal": {
		"dock": "bottom",
		"working_directory": "current_project_directory",
		"font_family": "JetBrainsMonoNL Nerd Font",
		"blinking": "terminal_controlled",
		"copy_on_select": false,
		"detect_venv": {
			"on": {
				"directories": [".env", "env", ".venv", "venv"],
				"activate_script": "default",
			},
		},
		"font_size": 14,
		"line_height": "comfortable",
		"option_as_meta": false,
		"button": true,
		"toolbar": {
			"breadcrumbs": true,
		},
	},
	"git": {
		"inline_blame": {
			"show_commit_summary": true,
		},
		"blame": {
			"show_avatar": true,
		},
	},
	// Privacy
	"telemetry": {
		"diagnostics": false,
		"metrics": false,
	},
}
